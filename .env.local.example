# CoinGecko Demo API Key (free)
# Get yours at: https://www.coingecko.com/en/api
# Click "Get Demo API Key" → sign up → copy key → paste below
COINGECKO_API_KEY=your_demo_api_key_here

# Google Gemini API key (free tier — used for AI research notes & news)
# Get yours at: https://aistudio.google.com/apikey
# Click "Create API key" → copy → paste below.
# Free-tier note: Google may use prompts/outputs to improve models. We never send personal data.
GOOGLE_API_KEY=your_gemini_api_key_here

# ── App password gate ────────────────────────────────────────
# Set both to require a password before anything loads. Leave APP_PASSWORD
# unset locally and the gate is skipped entirely (see lib/auth.ts).
# Generate a secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
# One entry per person: "name:password", comma separated. Names must be
# [a-z0-9_-] because they become storage path segments.
#
# The FIRST user keeps the original un-prefixed document paths; everyone
# else gets users/<name>/. That means enabling multi-user needs no data
# migration — keep the existing owner first in the list.
# Passwords are stored as PBKDF2 hashes, never plaintext. Generate an entry:
#   npx tsx scripts/hash-password.ts <username>
# (omit the password argument and it prompts, so it stays out of shell history)
APP_USERS="alice:pbkdf2.600000.<salt>.<hash>,bob:pbkdf2.600000.<salt>.<hash>"

# Legacy single-user fallback, used only when APP_USERS is unset.
APP_PASSWORD=choose-a-strong-password

AUTH_SECRET=64-hex-chars-random
