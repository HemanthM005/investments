# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Data — ALL data files are private; only the examples are tracked
# NEVER remove these rules — portfolio.json contains real personal financial data
# Use data/* (not data/) so negation patterns for example files work correctly
data/*
!data/portfolio.example.json
!data/daily-tracker.example.json

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
